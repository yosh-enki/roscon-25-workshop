    <!-- Elevated 3D Landing Pads (1000x1000x50 mm) with PBR Albedo Textures -->
    <!-- aruco_pad_home: at (0, 0, 0.025), PBR Albedo aruco_5.png -->
    <model name="aruco_pad_home">
      <static>true</static>
      <pose>0 0 0.025 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.0 1.0 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.0 1.0 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>materials/textures/aruco_5.png</albedo_map>
                <roughness>0.3</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

