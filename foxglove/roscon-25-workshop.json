    "Plot!altitude": {
      "paths": [
        {
          "timestampMethod": "receiveTime",
          "value": "/full_self_driving/telemetry.altitude_m",
          "enabled": true,
          "color": "#4e98e2"
        }
      ],
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "showLegend": true,
      "legendDisplay": "floating",
      "isSynced": true,
      "xAxisVal": "timestamp",
      "sidebarDimension": 200,
      "foxglovePanelTitle": "Altitude (m)",
      "yAxisLabel": "z [m]"
    },
    "Plot!battery_speed": {
      "paths": [
        {
          "timestampMethod": "receiveTime",
          "value": "/full_self_driving/telemetry.battery_percentage",
          "enabled": true,
          "color": "#45bf55"
        },
        {
          "timestampMethod": "receiveTime",
          "value": "/full_self_driving/telemetry.ground_speed_m_s",
          "enabled": true,
          "color": "#e28743"
