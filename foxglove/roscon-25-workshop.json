        "frame:odom": {
          "visible": true
        },
        "frame:map": {
          "visible": true
        },
        "frame:camera_frame": {
          "visible": true
        }
      },
      "topics": {
        "/robot_description": {
          "visible": true
        },
        "/point_cloud": {
          "visible": true,
          "colorField": "intensity",
          "colorMode": "colormap",
          "colorMap": "rainbow",
          "pointSize": 8
        },
        "/fmu/out/vehicle_odometry": {
          "visible": true
        }
      },
      "layers": {
        "grid": {
          "visible": true,
          "drawBehind": false,
          "frameLocked": true,
          "label": "Grid",
          "instanceId": "grid_world",
          "layerId": "foxglove.Grid",
          "size": 50,
          "divisions": 50,
          "lineWidth": 1,
          "color": "#248eff",
          "position": [0, 0, 0],
          "rotation": [0, 0, 0]
        }
      },
      "publish": {
        "type": "point",
        "poseTopic": "/move_base_simple/goal",
        "pointTopic": "/clicked_point"
      },
      "foxglovePanelTitle": "3D Flight Scene & Trajectory"
    },
    "RawMessages!fsd_state": {
      "topicPath": "/full_self_driving/state",
      "diffEnabled": false,
      "foxglovePanelTitle": "FSD Flight State Machine"
    },
    "RawMessages!live_lock": {
      "topicPath": "/full_self_driving/perception/live_target_lock",
      "diffEnabled": false,
      "foxglovePanelTitle": "Live Target Lock (Visual Servoing)"
