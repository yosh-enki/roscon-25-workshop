{
  "configById": {
    "CallService!select_target": {
      "serviceName": "/full_self_driving/select_target",
      "requestPayload": "{\n  \"target\": {\n    \"marker_id\": 1,\n    \"dictionary\": \"DICT_4X4_50\",\n    \"target_namespace\": \"aavc2026\"\n  },\n  \"expected_selection_revision\": 0\n}",
      "foxglovePanelTitle": "1. Select Target Identity"
    },
    "CallService!prepare_payload": {
      "serviceName": "/full_self_driving/prepare_payload",
      "requestPayload": "{\n  \"request_id\": \"sortie_prep\",\n  \"operation\": 2,\n  \"expected_selection_revision\": 0\n}",
      "foxglovePanelTitle": "2. Prepare Cargo Payload"
    },
    "CallService!emergency_stop": {
      "serviceName": "/full_self_driving/emergency_stop",
      "requestPayload": "{\n  \"reason\": \"Operator manual emergency stop trigger\"\n}",
      "foxglovePanelTitle": "🚨 EMERGENCY STOP"
    },
    "RawMessages!readiness": {
      "topicPath": "/full_self_driving/readiness",
      "diffEnabled": false,
      "diffMethod": "custom",
      "diffTopicPath": "",
      "showFullMessageForDiff": false,
      "foxglovePanelTitle": "Pre-flight Readiness Gate"
    },
    "ImageView!fsd_annotated": {
      "cameraTopic": "/full_self_driving/perception/annotated_image",
      "transformMarkers": false,
      "synchronize": false,
      "mode": "fit",
      "pan": {
        "x": 0,
        "y": 0
      },
      "zoom": 1,
      "foxglovePanelTitle": "ArUco Detection & 2D Track Feed"
    },
    "3D!vehicle_scene": {
      "cameraState": {
        "perspective": true,
        "distance": 15.0,
        "phi": 70.0,
        "thetaOffset": 90.0,
        "targetOffset": [0, 0, 0],
        "target": [0, 0, 0],
        "targetOrientation": [0, 0, 0, 1],
        "fovy": 45,
        "near": 0.5,
        "far": 5000
      },
      "followMode": "follow-pose",
      "followTf": "map",
      "scene": {
        "enableStats": false,
        "transforms": {
          "editable": false,
          "showLabel": true,
          "lineWidth": 0
        }
      },
      "transforms": {
        "frame:base_link": {
          "visible": true
