      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "showLegend": true,
      "legendDisplay": "floating",
      "isSynced": true,
      "xAxisVal": "timestamp",
      "sidebarDimension": 200,
      "foxglovePanelTitle": "Battery % & Speed (m/s)"
    },
    "RawMessages!pad_registry": {
      "topicPath": "/full_self_driving/pad_registry",
      "diffEnabled": false,
