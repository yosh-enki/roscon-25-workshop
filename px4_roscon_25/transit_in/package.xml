<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>transit_in</name>
  <version>0.0.1</version>
  <description>PX4 ROS 2 custom mode for ordered global Transit In waypoints.</description>
  <maintainer email="ubuntu@todo.todo">ROSCon workshop</maintainer>
  <license>CC-BY-SA-4.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>eigen3_cmake_module</buildtool_depend>
  <build_export_depend>eigen3_cmake_module</build_export_depend>

  <depend>eigen</depend>
  <depend>rclcpp</depend>
  <depend>px4_msgs</depend>
  <depend>px4_ros2_cpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
