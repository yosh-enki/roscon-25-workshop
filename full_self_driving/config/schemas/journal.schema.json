{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JournalEntry",
  "type": "object",
  "required": [
    "entry_sequence",
    "event_id",
    "timestamp_monotonic_ns",
    "checksum"
  ],
  "properties": {
    "entry_sequence": { "type": "integer", "minimum": 1 },
    "event_id": { "type": "string", "maxLength": 64 },
    "idempotency_key": { "type": "string", "maxLength": 64 },
    "mission_id": { "type": "string", "maxLength": 64 },
    "sortie_id": { "type": "string", "maxLength": 64 },
    "snapshot_hash": { "type": "string", "maxLength": 64 },
    "severity": { "type": "integer", "minimum": 0, "maximum": 3 },
    "source": { "type": "integer", "minimum": 0, "maximum": 8 },
    "component": { "type": "string", "maxLength": 32 },
    "detail": { "type": "string", "maxLength": 512 },
    "timestamp_monotonic_ns": { "type": "integer", "minimum": 0 },
    "checksum": { "type": "string", "maxLength": 64 }
  }
}
