<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLProfiles">
    <!--
      Authoritative FastDDS Security Profile for Full Self-Driving Stack.
      Enforces PKI-DH Authentication, Access-Permissions Control,
      AES-GCM-256 Cryptographic Payload Encryption, and Shared Memory Transport.
    -->
    <participant profile_name="fsd_secure_participant" is_default_profile="true">
        <rtps>
            <name>fsd_secure_participant</name>
            
            <!-- Default Builtin Transports enabling Shared Memory (SHM) + UDPv4 -->
            <useBuiltinTransports>true</useBuiltinTransports>

            <propertiesPolicy>
                <properties>
                    <!-- 1. Authentication Plugin (OMG DDS Security PKI-DH) -->
                    <property>
                        <name>dds.sec.auth.plugin</name>
                        <value>builtin.PKI-DH</value>
                    </property>
                    <property>
                        <name>dds.sec.auth.builtin.PKI-DH.identity_ca</name>
                        <value>file://public/ca.cert.pem</value>
                    </property>
                    <property>
                        <name>dds.sec.auth.builtin.PKI-DH.identity_certificate</name>
                        <value>file://cert.pem</value>
                    </property>
                    <property>
                        <name>dds.sec.auth.builtin.PKI-DH.private_key</name>
                        <value>file://key.pem</value>
                    </property>

                    <!-- 2. Access Control Plugin (OMG DDS Security Access-Permissions) -->
                    <property>
                        <name>dds.sec.access.plugin</name>
                        <value>builtin.Access-Permissions</value>
                    </property>
                    <property>
                        <name>dds.sec.access.builtin.Access-Permissions.permissions_ca</name>
                        <value>file://public/ca.cert.pem</value>
                    </property>
                    <property>
                        <name>dds.sec.access.builtin.Access-Permissions.governance</name>
                        <value>file://governance.p7s</value>
                    </property>
                    <property>
                        <name>dds.sec.access.builtin.Access-Permissions.permissions</name>
                        <value>file://permissions.p7s</value>
                    </property>

                    <!-- 3. Cryptographic Plugin (AES-GCM-256) -->
                    <property>
                        <name>dds.sec.crypto.plugin</name>
                        <value>builtin.AES-GCM-256</value>
                    </property>

                    <!-- 4. Logging & Diagnostics Plugin -->
                    <property>
                        <name>dds.sec.log.plugin</name>
                        <value>builtin.DDS_LogTopic</value>
                    </property>
                    <property>
                        <name>dds.sec.log.builtin.DDS_LogTopic.logging_level</name>
                        <value>SECURITY_WARNING</value>
                    </property>
                </properties>
            </propertiesPolicy>
        </rtps>
    </participant>
</profiles>
