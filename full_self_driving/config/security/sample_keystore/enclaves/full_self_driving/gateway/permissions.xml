<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="omg_shared_ca_permissions.xsd">
  <permissions>
    <grant name="/full_self_driving/gateway">
      <subject_name>CN=/full_self_driving/gateway</subject_name>
      <validity>
        <not_before>2026-08-18T12:50:59</not_before>
        <not_after>2036-08-15T12:50:59</not_after>
      </validity>
      <allow_rule>
        <domains>
          <id>0</id>
        </domains>
        <publish>
          <topics>
            <topic>rt/full_self_driving/health/gateway</topic>
            <topic>rt/full_self_driving/target_selection</topic>
            <topic>rt/rosout</topic>
            <topic>rt/parameter_events</topic>
            <topic>rq/full_self_driving/emergency_stopRequest</topic>
            <topic>rq/full_self_driving/prepare_payloadRequest</topic>
            <topic>rr/full_self_driving/fsd_gateway/*</topic>
          </topics>
        </publish>
        <subscribe>
          <topics>
            <topic>rt/full_self_driving/state</topic>
            <topic>rt/full_self_driving/telemetry</topic>
            <topic>rt/full_self_driving/readiness</topic>
            <topic>rt/full_self_driving/payload/status</topic>
            <topic>rt/full_self_driving/plan/working_status</topic>
            <topic>rt/full_self_driving/pad_registry/snapshot</topic>
            <topic>rt/clock</topic>
            <topic>rr/full_self_driving/emergency_stopReply</topic>
            <topic>rr/full_self_driving/prepare_payloadReply</topic>
            <topic>rq/full_self_driving/fsd_gateway/*</topic>
          </topics>
        </subscribe>
      </allow_rule>
      <default>DENY</default>
    </grant>
  </permissions>
</dds>
